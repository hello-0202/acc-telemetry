# ---------------- 依赖 / 前端构建 ----------------
node_modules/
dist/
dist-ssr/
*.local

# ---------------- Rust / Tauri ----------------
src-tauri/target/
src-tauri/gen/schemas/
# sidecar 是打包生成的，克隆后需先构建再复制过来
src-tauri/binaries/*.exe

# ---------------- Python / PyInstaller ----------------
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/
python-server/build/
python-server/dist/
# PyInstaller 增量构建产物（构建过程临时生成，体积大）
python-server/build_new/
python-server/dist_new/
# 一次性重打包目录（按日期命名，构建完同步三处 exe 后可删）
python-server/build_paths_*/
python-server/dist_paths_*/
# 采集脚本的原始采样和导出的地图，属于本机数据
python-server/tools/track_data/
# 广播探针落盘的原始报文：可能含真实车手姓名、体积大，只入库脚本与用例
python-server/tests/fixtures/

# ---------------- 本地数据库 / 日志 ----------------
*.db
*.db-wal
*.db-shm
crash_log.txt
logs/
*.log

# ---------------- 临时文件 ----------------
.tmp-*
.tmp_*
tmp/
*.tmp
# 赛道地图调试预览（本地生成，体积大，不入库）
docs/trackmap-*.html

# ---------------- 本地工具状态 ----------------
.workbuddy/

# ---------------- 环境变量 / 密钥 ----------------
# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# Snowpack dependency directory (https://snowpack.dev/)
web_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files
.env
.env.*
!.env.example

