{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "opener:default",
    "shell:default",
    "process:default",
    "process:allow-restart",
    "allow-stop-sidecar",
    "allow-toggle-overlay",
    "allow-show-overlay",
    "allow-hide-overlay",
    "allow-set-overlay-locked",
    "allow-set-overlay-slots",
    "allow-list-user-themes",
    "allow-open-themes-dir",
    "allow-delete-user-theme",
    "allow-open-theme-preview",
    "allow-import-theme-zip",
    "allow-export-theme-template",
    "dialog:default",
    "core:event:allow-emit"
  ]
}