{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "acc-telemetry",
  "version": "0.3.1",
  "identifier": "com.acc.telemetry",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "acc-telemetry",
        "width": 1000,
        "height": 680,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/telemetry_core"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
    "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZDNEQyRkZCMzdDOTFEQkMKUldTOEhjazMreTlOYkdYOU9FaEl2cXV1VDRndHl1QkR3YXhZZ1lrRmNzdVg5dlBZU29scUpyZ1AK",
    "endpoints": [
      "https://github.com/hello-0202/acc-telemetry/releases/latest/download/latest.json"
    ],
    "windows": { "installMode": "passive" },
    "requireSignedVersion": true
  }
  }
}